NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
FRONTEND_ORIGINS=http://localhost:3001
TEAM12_PARTNER_API_KEY=replace-with-team-12-partner-key
TEAM12_WEBHOOK_SECRET=replace-with-team-12-webhook-secret
TEAM12_PARTNER_ACTIVITIES_URL=https://pd-project-events-clubs.onrender.com/partner/activities
TEAM12_PARTNER_WEBHOOK_URL=https://pd-project-events-clubs.onrender.com/webhooks/partner
TEAM10_PARTNER_KEY=replace-with-team-10-partner-key
TEAM10_WEBHOOK_SECRET=replace-with-team-10-webhook-secret
STUDENT_IDENTITY_API_KEY=replace-with-rotated-student-identity-api-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
## Helpdesk (Team 14) -- separate from all other partner credentials
# Dedicated read-only credential that Helpdesk sends as Authorization: Bearer ...
HELPDESK_API_KEY=replace-with-dedicated-helpdesk-lookup-key
# Set the receiver URL only after Team 14 supplies it. Never point tests at production.
HELPDESK_WEBHOOK_URL=
HELPDESK_WEBHOOK_SECRET=replace-with-team14-signing-secret
# Private worker credential. Never share it with Helpdesk.
HELPDESK_WORKER_SECRET=replace-with-private-worker-secret
# Used only by npm run worker:helpdesk on the machine running the scheduler.
HELPDESK_WORKER_URL=http://localhost:3000/api/integrations/helpdesk/deliver
